# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/xitlar
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# JPA / Hibernate Configuration
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Security & JWT Configuration (Must be at least 32 characters / 256 bits)
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long

# Initial Default Administrator Credentials (used by DataInitializer)
ADMIN_DEFAULT_USERNAME=admin_username
ADMIN_DEFAULT_PASSWORD=admin_secure_password

# Storage Configuration
STORAGE_PATH=./storage

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
