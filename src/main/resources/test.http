### Change own password (any authenticated user)
PUT http://localhost:8080/api/v1/users/me/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJlamF2bG9uIiwiaWF0IjoxNzg3NTk0ODY4LCJleHAiOjE3ODgxOTk2Njh9.6ZOi_wkDPJISwY_9-ESqna3-qbZJSbAkWVMULxcfXfU

{
  "currentPassword": "password123",
  "newPassword": "newpass456",
  "confirmPassword": "newpass456"
}

### Reset user password (ADMIN)
PUT http://localhost:8080/api/v1/users/3/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJlamF2bG9uIiwiaWF0IjoxNzg3NTk0ODY4LCJleHAiOjE3ODgxOTk2Njh9.6ZOi_wkDPJISwY_9-ESqna3-qbZJSbAkWVMULxcfXfU

{
  "newPassword": "resetpass789"
}

### Update user role (ADMIN)
PUT http://localhost:8080/api/v1/users/3/role
Content-Type: application/json
Authorization: Bearer <admin-token>

{
  "role": "USER"
}

### Create moderator (ADMIN)
POST http://localhost:8080/api/v1/moderators
Content-Type: application/json
Authorization: Bearer <admin-token>

{
  "firstName": "Mod",
  "lastName": "Erator",
  "username": "moderator1",
  "password": "modpass123",
  "confirmPassword": "modpass123"
}

### List moderators (ADMIN)
GET http://localhost:8080/api/v1/moderators
Authorization: Bearer <admin-token>

### Update moderator (ADMIN)
PUT http://localhost:8080/api/v1/moderators/2
Content-Type: application/json
Authorization: Bearer <admin-token>

{
  "firstName": "Updated",
  "lastName": "Moderator",
  "username": "moderator1"
}

### Reset moderator password (ADMIN)
PUT http://localhost:8080/api/v1/moderators/2/password
Content-Type: application/json
Authorization: Bearer <admin-token>

{
  "newPassword": "newmodpass123"
}

### Delete moderator (ADMIN)
DELETE http://localhost:8080/api/v1/moderators/2
Authorization: Bearer <admin-token>

